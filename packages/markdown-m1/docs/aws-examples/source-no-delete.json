{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectStorage",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": "arn:aws:s3:::replace-with-your-bucket"
    },
    {
      "Sid": "ListOnlySite",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::replace-with-your-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "sites/example-site/",
            "sites/example-site/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadSiteVersionsAndLocks",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:GetObjectLegalHold"
      ],
      "Resource": "arn:aws:s3:::replace-with-your-bucket/sites/example-site/*"
    },
    {
      "Sid": "SaveSiteResources",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention"
      ],
      "Resource": "arn:aws:s3:::replace-with-your-bucket/sites/example-site/*"
    },
    {
      "Sid": "DenyDeletionAndBypass",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention",
        "s3:PutObjectLegalHold"
      ],
      "Resource": "arn:aws:s3:::replace-with-your-bucket/sites/example-site/*"
    }
  ]
}
