[Unit]
Description=Retrieve independent observer status for WordPress
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=owr-observer-relay
Group=owr-observer-report
UMask=0027
ExecStart=/usr/bin/python3 /opt/owr/observer-status.py pull --config /etc/owr/observer-status-pull.json
TimeoutStartSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/owr-observer-relay /var/lib/owr-observer-report
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
