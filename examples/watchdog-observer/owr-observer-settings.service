[Unit]
Description=Transfer independent watchdog notification settings requests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=owr-observer-relay
Group=owr-observer-relay
UMask=0027
ExecStart=/usr/bin/python3 /opt/owr/observer-settings.py exchange --config /etc/owr/observer-settings-relay.json
TimeoutStartSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/owr-observer-relay /var/lib/owr-observer-requests
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
