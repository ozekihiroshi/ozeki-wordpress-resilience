[Unit]
Description=Ozeki daily status relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=owr-status-relay
Group=www-data
ExecStart=/usr/bin/python3 /opt/owr/tools/daily-status-transfer.py --config /etc/owr/daily-status-relay.json relay --interval 60
Restart=on-failure
RestartSec=15
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/owr-status-web

[Install]
WantedBy=multi-user.target
