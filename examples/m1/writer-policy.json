{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteNewExperimentAssets",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::owr-example-bucket/wordpress-test/*"
    },
    {
      "Sid": "DenyRecoveryDataDeletion",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::owr-example-bucket/wordpress-test/*"
    }
  ]
}