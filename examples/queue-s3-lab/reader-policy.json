{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExactLabVersions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion",
        "s3:GetObjectRetention"
      ],
      "Resource": "arn:aws:s3:::ceri-link-resilience-lock-lab-121426368082/sites/isolated-queue-lab/sets/*"
    },
    {
      "Sid": "NoLabMutation",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectRetention",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:BypassGovernanceRetention"
      ],
      "Resource": "arn:aws:s3:::ceri-link-resilience-lock-lab-121426368082/sites/isolated-queue-lab/sets/*"
    }
  ]
}
