  "classified_findings": {
    "environment": [
      "Host forwarding policy blocked dedicated Docker bridge TCP while DNS and DB startup worked; temporary same-bridge-only rules allowed the experiment and were removed."
    ],
    "test_infrastructure": [
      "Default containerd image store exposed a different image identity; exact-ID gate refused before WP startup. Classic overlay2 matched original IDs.",
      "Untagged image inventory required --all.",
      "Containerd execution namespaces separated; monitor handled container removal races.",
      "Docker crashed with a nil-pointer panic in a separate Linux network namespace; root cause remains undetermined. That attempt is not counted as success."
    ],
    "product_limits": [
      "Classic-compatible image identity and architecture required; automated cross-image-store admission/translation is not implemented.",
      "Complete host-runtime compatibility profile not yet represented in E.",
      "No generic deployment wizard, partial-WP resume or independent signed approval of the new kit."
    ]
  },
