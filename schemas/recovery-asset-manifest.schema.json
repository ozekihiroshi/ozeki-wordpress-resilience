{
  "type": "object",
  "properties": {
    "format": {
      "const": "owr-recovery-asset-manifest"
    },
    "schema_version": {
      "const": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "set_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_level": {
      "const": "E1"
    },
    "authenticity": {
      "const": "unverified"
    },
    "consistency": {
      "const": "uncoordinated"
    },
    "procedure_id": {
      "const": "owr-m1-independent-recovery-v1"
    },
    "environment": {
      "type": "object",
      "properties": {
        "wordpress": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "php": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "database": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_.+ -]{1,128}$"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[A-Za-z0-9_.+ -]{1,128}$"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "inventory_scope": {
          "const": "phase1_baseline_only"
        }
      },
      "required": [
        "wordpress",
        "php",
        "database",
        "themes",
        "plugins",
        "inventory_scope"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "role": {
            "enum": [
              "database",
              "uploads",
              "wordpress_core",
              "themes",
              "plugins",
              "configuration",
              "runtime",
              "recovery_manifest"
            ]
          },
          "required": {
            "const": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "pending"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "required": [
                  "kind",
                  "reason"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "local"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "s3"
                  },
                  "bucket": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[A-Za-z0-9_./-]+$"
                  },
                  "version_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "not": {
                      "enum": [
                        "null"
                      ]
                    }
                  },
                  "credential_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "required": [
                  "kind",
                  "bucket",
                  "region",
                  "key",
                  "version_id",
                  "credential_ref"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sha256": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1099511627776
          }
        },
        "required": [
          "id",
          "role",
          "required",
          "depends_on",
          "locator",
          "sha256",
          "size_bytes"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "locator": {
                  "properties": {
                    "kind": {
                      "const": "pending"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "sha256": {
                  "type": "null"
                },
                "size_bytes": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "sha256": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1099511627776
                }
              }
            }
          }
        ]
      },
      "maxItems": 128,
      "minItems": 8
    }
  },
  "required": [
    "format",
    "schema_version",
    "site_id",
    "set_id",
    "created_at",
    "evidence_level",
    "authenticity",
    "consistency",
    "procedure_id",
    "environment",
    "assets"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
